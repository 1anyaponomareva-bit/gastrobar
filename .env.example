# Доступ к dev с телефона в Wi‑Fi: в консоли после `npm run dev` смотрите точный URL (порт может быть не 3000).
# Брандмауэр Windows может блокировать входящие — разрешите порт для Node или см. подсказку в выводе dev.
# Продакшен по LAN: после `npm run build` → `npm run start:lan` и открывайте http://<IP_ПК>:3000
#
# Если сайт по туннелю (ngrok) открывается «пустым» — добавь hostname без https://
# Пример: ALLOWED_DEV_ORIGINS=abc-123.ngrok-free.dev
# Несколько через запятую: host1.ngrok-free.dev,host2.ngrok-free.app
# ALLOWED_DEV_ORIGINS=

# --- Supabase (аналитика спинов, дурак онлайн) ---
# Project URL из Supabase → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon / publishable key (не service_role!)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Опционально: true — console.log при отправке спина
# NEXT_PUBLIC_SPIN_ANALYTICS_DEBUG=

# --- Poster-test accounts (/poster-test only) ---
# Service role key (server-only) for poster_test_users / poster_test_orders
# SUPABASE_SERVICE_ROLE_KEY=
# Cookie session signing secret (min 32 chars)
# POSTER_TEST_AUTH_SECRET=
# Wheel test mode: show reset button and allow DELETE /api/poster-test/wheel
# POSTER_TEST_WHEEL_TEST_MODE=true
# Or only for specific emails (1anyaponomareva@gmail.com is always included in code):
# POSTER_TEST_WHEEL_TESTER_EMAILS=1anyaponomareva@gmail.com,other@test.com
# Merchant panel (/poster-test/merchant) access for specific emails:
# POSTER_TEST_MERCHANT_EMAILS=1anyaponomareva@gmail.com,other@test.com
# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Telegram Login Widget
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=my_bot_name

# --- Poster API (/poster-test orders) ---
# Token from Poster → Settings → Integrations
# POSTER_API_TOKEN=
# Spot id for incoming orders (required). All website orders use one spot / one check.
# GASTROBAR = 1
# POSTER_SPOT_ID=1
